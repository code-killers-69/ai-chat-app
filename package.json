{
  "name": "chat-app-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:frontend": "pnpm --filter @chat-app/frontend dev",
    "dev:backend": "pnpm --filter @chat-app/backend dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @chat-app/backend start"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
